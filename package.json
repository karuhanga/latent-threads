{
  "name": "latent-threads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "dev": "node scripts/build-data.mjs && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:data": "node scripts/build-data.mjs",
    "build": "node scripts/build-data.mjs && vite build",
    "check": "pnpm validate:data && pnpm typecheck && pnpm test && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "publish:pages": "node scripts/publish.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
